<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
    <key>CFBundleDisplayName</key><string>Harness</string>
    <key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
    <key>CFBundleName</key><string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key><string>$(CURRENT_PROJECT_VERSION)</string>
    <!-- Populate with real auto-renewable product IDs from this app's App Store Connect record.
         Empty intentionally means subscriptions are unconfigured; it never grants paid access. -->
    <key>HarnessSubscriptionProductIDs</key><array/>
    <!-- Enable only after Apple approves the account's PCC capability and the app's
         provisioning profile contains com.apple.developer.private-cloud-compute. -->
    <key>HarnessPrivateCloudEnabled</key><false/>
    <key>CFBundleURLTypes</key><array><dict>
        <key>CFBundleURLName</key><string>org.harness.ios</string>
        <key>CFBundleURLSchemes</key><array><string>harness</string></array>
    </dict></array>
    <key>LSRequiresIPhoneOS</key><true/>
    <key>LSSupportsOpeningDocumentsInPlace</key><true/>
    <key>UIFileSharingEnabled</key><true/>
    <key>NSCameraUsageDescription</key><string>Scan a one-use QR code to securely pair your computer. Camera access is requested only when you choose to scan.</string>
    <key>NSFaceIDUsageDescription</key><string>Authorize sensitive agent actions, including computer command execution.</string>
    <key>NSMicrophoneUsageDescription</key><string>Harness turns your voice into text when you tap Dictate. Audio is processed and discarded, never saved.</string>
    <key>NSLocalNetworkUsageDescription</key><string>Connect to computers that you explicitly pair with Harness on your local network.</string>
    <key>NSAppTransportSecurity</key><dict><key>NSAllowsLocalNetworking</key><true/></dict>
    <key>UIBackgroundModes</key><array><string>audio</string></array>
    <key>UIApplicationSceneManifest</key><dict><key>UIApplicationSupportsMultipleScenes</key><false/></dict>
    <key>UILaunchScreen</key><dict/>
    <key>UISupportedInterfaceOrientations</key><array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
</dict></plist>
